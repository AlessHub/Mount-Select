<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.1</Version>
    <PackageProjectUrl>https://github.com/AlessHub/Mount-Select</PackageProjectUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>$(AppData)\XIVLauncher\devPlugins\MountSelect\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Exclude unnecessary files from output -->
    <CopyBuildOutputToPublishDirectory>true</CopyBuildOutputToPublishDirectory>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!-- icon.png removed - not needed in zip, loaded from GitHub via IconUrl -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\mounts.json" />
  </ItemGroup>

  <!-- Exclude .deps.json from output -->
  <Target Name="RemoveDepsJson" AfterTargets="Build">
    <Delete Files="$(OutputPath)$(AssemblyName).deps.json" />
  </Target>

</Project>